{
  "name": "salinaral",
  "version": "0.0.0",
  "private": true,
  "description": "Spec-driven monorepo foundation for the SalinAral teacher lesson-localisation workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run phase:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run spec:lint && npm run secrets:scan",
    "dev:api": "npm run dev --workspace @salinaral/api",
    "dev:web": "npm run dev --workspace @salinaral/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && markdownlint-cli2",
    "phase:check": "node scripts/check-phase-scope.mjs",
    "secrets:scan": "secretlint \"**/*\"",
    "spec:lint": "redocly lint specs/openapi.yaml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.51.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
